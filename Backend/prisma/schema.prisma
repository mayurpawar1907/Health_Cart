generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum FamilyRelation {
  SPOUSE
  PARENT
  CHILD
  SIBLING
  OTHER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

enum CollectionType {
  LAB
  HOME
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  COD
  WALLET
}

enum ReportStatus {
  PENDING
  PROCESSING
  AVAILABLE
}

enum NotificationType {
  APPOINTMENT_CONFIRMATION
  APPOINTMENT_REMINDER
  APPOINTMENT_CANCELLATION
  APPOINTMENT_RESCHEDULED
  REPORT_AVAILABLE
  MEMBERSHIP_EXPIRY
  PROMOTIONAL
}

model User {
  id           String    @id @default(cuid())
  fullName     String
  email        String    @unique
  mobile       String    @unique
  passwordHash String
  dateOfBirth  DateTime?
  gender       Gender?
  role         Role      @default(USER)
  isActive     Boolean   @default(true)
  avatarUrl    String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  profile             UserProfile?
  addresses           Address[]
  familyMembers       FamilyMember[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  appointments        Appointment[]
  memberships         Membership[]
  notifications       Notification[]
  reports             TestReport[]
  auditLogs           AuditLog[]
  reminders           TestReminder[]
  whatsappMessages    WhatsAppMessage[]
  referralCode        String?   @unique
  referredByUserId    String?
  referredBy          User?     @relation("UserReferrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referrals           User[]    @relation("UserReferrals")
  wallet              Wallet?
  referralsMade       Referral[] @relation("Referrer")
  referralReceived    Referral?  @relation("ReferredUser")
  paymentTransactions PaymentTransaction[]
}

model UserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  language        String   @default("en")
  theme           String   @default("system")
  notificationsOn Boolean  @default(true)
  whatsappOn      Boolean  @default(true)
  locationLat     Decimal? @db.Decimal(10, 7)
  locationLng     Decimal? @db.Decimal(10, 7)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  line1     String
  city      String
  state     String
  pincode   String
  label     String?
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  isPrimary Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([userId])
}

model FamilyMember {
  id          String         @id @default(cuid())
  userId      String
  name        String
  relation    FamilyRelation
  dateOfBirth DateTime?
  gender      Gender?
  age         Int?
  mobile      String?
  createdAt   DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardLinks   MembershipMember[]
  appointments Appointment[]

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @db.VarChar(255)
  userAgent String?   @db.VarChar(512)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TestCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  tests       Test[]
}

model Test {
  id                    String   @id @default(cuid())
  categoryId            String
  name                  String
  slug                  String   @unique
  shortDescription      String   @db.VarChar(500)
  description           String   @db.Text
  preparation           String   @db.Text
  sampleType            String
  reportHours           Int      @default(24)
  price                 Decimal  @db.Decimal(10, 2)
  discountPercent       Decimal  @default(0) @db.Decimal(5, 2)
  membershipDiscountPct Decimal  @default(0) @db.Decimal(5, 2)
  membershipEligible    Boolean  @default(false)
  membershipFree        Boolean  @default(false)
  isPopular             Boolean  @default(false)
  isPackage             Boolean  @default(false)
  isActive              Boolean  @default(true)
  faqs                  Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  deletedAt             DateTime?

  category           TestCategory           @relation(fields: [categoryId], references: [id])
  parameters         TestParameter[]
  appointments       Appointment[]
  packageTests       HealthPackageTest[]    @relation("Package")
  includedInPackages HealthPackageTest[]    @relation("IncludedTest")
  eligibleBenefits   MembershipBenefit[]
  usage              MembershipUsage[]
  reminders          TestReminder[]

  @@index([categoryId])
  @@index([name])
  @@index([isPopular, isActive])
}

model TestParameter {
  id     String @id @default(cuid())
  testId String
  name   String
  unit   String?
  test   Test   @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
}

model HealthPackageTest {
  id            String @id @default(cuid())
  packageTestId String
  includedTestId String
  package       Test   @relation("Package", fields: [packageTestId], references: [id], onDelete: Cascade)
  includedTest  Test   @relation("IncludedTest", fields: [includedTestId], references: [id], onDelete: Cascade)

  @@unique([packageTestId, includedTestId])
}

model Appointment {
  id                 String             @id @default(cuid())
  code               String             @unique
  userId             String
  testId             String
  date               DateTime           @db.Date
  timeSlot           String
  status             AppointmentStatus  @default(CONFIRMED)
  patientName        String
  patientAge         Int?
  notes              String?            @db.Text
  collectionType     CollectionType     @default(HOME)
  addressId          String?
  familyMemberId     String?
  location           String             @default("Home collection")
  deliveryAddress    String?            @db.Text
  latitude           Decimal?           @db.Decimal(10, 7)
  longitude          Decimal?           @db.Decimal(10, 7)
  originalPrice      Decimal?           @db.Decimal(10, 2)
  membershipDiscount Decimal?           @db.Decimal(10, 2)
  cardDiscount       Decimal?           @db.Decimal(10, 2)
  referralDiscount   Decimal?           @db.Decimal(10, 2)
  walletDiscount     Decimal?           @db.Decimal(10, 2)
  finalPrice         Decimal?           @db.Decimal(10, 2)
  payableAmount      Decimal?           @db.Decimal(10, 2)
  paymentStatus      PaymentStatus      @default(PENDING)
  paymentMethod      PaymentMethod?
  reminderEnabled    Boolean            @default(true)
  reminderSentAt     DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  user         User          @relation(fields: [userId], references: [id])
  test         Test          @relation(fields: [testId], references: [id])
  address      Address?      @relation(fields: [addressId], references: [id])
  familyMember FamilyMember? @relation(fields: [familyMemberId], references: [id])
  reports             TestReport[]
  usage               MembershipUsage[]
  reminders           TestReminder[]
  paymentTransactions PaymentTransaction[]

  @@index([userId, status])
  @@index([date])
}

model MembershipPlan {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  price               Decimal  @db.Decimal(10, 2)
  durationDays        Int
  description         String   @db.Text
  isFree              Boolean  @default(false)
  flatDiscountPercent Decimal  @default(0) @db.Decimal(5, 2)
  maxFamilyMembers    Int      @default(4)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  benefits            MembershipBenefit[]
  memberships         Membership[]
}

model MembershipBenefit {
  id          String  @id @default(cuid())
  planId      String
  title       String
  description String  @db.Text
  testId      String?
  freeTest    Boolean @default(false)
  plan        MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  test        Test?   @relation(fields: [testId], references: [id])

  @@index([planId])
}

model Membership {
  id         String    @id @default(cuid())
  userId     String
  planId     String
  number     String    @unique
  startsAt   DateTime
  expiresAt  DateTime
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id])
  plan       MembershipPlan @relation(fields: [planId], references: [id])
  usage      MembershipUsage[]
  members    MembershipMember[]

  @@index([userId, isActive])
}

model MembershipMember {
  id             String        @id @default(cuid())
  membershipId   String
  familyMemberId String?
  name           String
  relation       String
  isPrimary      Boolean       @default(false)
  membership     Membership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  familyMember   FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)

  @@index([membershipId])
}

model MembershipUsage {
  id            String   @id @default(cuid())
  membershipId  String
  testId        String
  appointmentId String?
  usedAt        DateTime @default(now())
  note          String?
  membership    Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  test          Test       @relation(fields: [testId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
}

model TestReport {
  id            String       @id @default(cuid())
  userId        String
  appointmentId String
  status        ReportStatus @default(PENDING)
  fileUrl       String?      @db.Text
  fileName      String?
  fileMimeType  String?
  fileSize      Int?
  summary       String?      @db.Text
  releasedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id])
  appointment   Appointment  @relation(fields: [appointmentId], references: [id])

  @@index([userId])
}

model TestReminder {
  id            String    @id @default(cuid())
  userId        String
  testId        String?
  appointmentId String?
  label         String
  remindAt      DateTime
  isActive      Boolean   @default(true)
  notifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  test          Test?     @relation(fields: [testId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([userId, isActive])
  @@index([remindAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String           @db.Text
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model WhatsAppMessage {
  id        String   @id @default(cuid())
  userId    String
  mobile    String
  template  String
  body      String   @db.Text
  status    String   @default("SENT")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Wallet {
  id                   String              @id @default(cuid())
  userId               String              @unique
  balance              Decimal             @default(0) @db.Decimal(10, 2)
  referralBalance      Decimal             @default(0) @db.Decimal(10, 2)
  joiningBonusCredited Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions         WalletTransaction[]

  @@index([userId])
}

model WalletTransaction {
  id                   String   @id @default(cuid())
  walletId             String
  type                 String
  amount               Decimal  @db.Decimal(10, 2)
  balanceAfter         Decimal  @db.Decimal(10, 2)
  referralBalanceAfter Decimal  @db.Decimal(10, 2)
  description          String   @db.Text
  appointmentId        String?
  meta                 Json?
  createdAt            DateTime @default(now())
  wallet               Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

model Referral {
  id               String   @id @default(cuid())
  referrerId       String
  referredUserId   String   @unique
  bonusAmount      Decimal  @db.Decimal(10, 2)
  creditedAt       DateTime @default(now())
  referrer         User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser     User     @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
}

model PlatformSettings {
  id                          String   @id @default("default")
  paymentPromoPercent         Decimal  @default(30) @db.Decimal(5, 2)
  paymentPromoActive          Boolean  @default(true)
  paymentPromoApplyToAllUsers Boolean  @default(true)
  promoLabel                  String   @default("Extra off special price at payment")
  updatedByUserId             String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model PaymentTransaction {
  id            String         @id @default(cuid())
  appointmentId String
  userId        String
  bookingCode   String
  testName      String
  invoiceNumber String?        @unique
  amount        Decimal        @db.Decimal(10, 2)
  currency      String         @default("INR")
  method        PaymentMethod
  status        PaymentStatus
  breakdown     Json
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([appointmentId])
  @@index([status, createdAt])
  @@index([bookingCode])
}
